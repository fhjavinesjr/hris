<!-- SQL-free, bean-backed internal evidence readiness report. This is not a CSC-prescribed form. -->
<jasperReport name="evidence_readiness_report" language="java" pageWidth="612" pageHeight="792" columnWidth="540" leftMargin="36" rightMargin="36" topMargin="30" bottomMargin="30" uuid="327e36fe-1a39-42c7-8734-7e658fd85be0">
 <property name="net.sf.jasperreports.compiler.xml.parser.validation" value="false"/>
