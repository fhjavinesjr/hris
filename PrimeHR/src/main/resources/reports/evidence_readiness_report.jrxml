 </columnHeader>
 <detail><band height="36" splitType="Stretch">
  <element kind="textField" x="0" y="0" width="90" height="36" fontName="Arial" fontSize="7" bold="true" textAdjust="StretchHeight" stretchType="ContainerHeight"><expression><![CDATA[$F{section}]]></expression><box><pen lineWidth="0.3"/></box></element>
  <element kind="textField" x="90" y="0" width="140" height="36" fontName="Arial" fontSize="7" textAdjust="StretchHeight" stretchType="ContainerHeight"><expression><![CDATA[$F{item}]]></expression><box><pen lineWidth="0.3"/></box></element>
