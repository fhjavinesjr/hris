  <summary height="50"><element kind="textField" mode="Opaque" x="0" y="2" width="806" height="18" backcolor="#EEF2F7" fontName="Arial" fontSize="8" bold="true" hTextAlign="Right"><expression><![CDATA["Final rating: " + ($P{finalScore} == null ? "N/A" : $P{finalScore}) + " — " + $P{ratingLabel}]]></expression></element><element kind="textField" x="0" y="22" width="806" height="24" fontName="Arial" fontSize="5" textAdjust="StretchHeight"><expression><![CDATA["Immutable metadata: " + $P{metadataReference} + " | " + $P{generated}]]></expression></element></summary>
