  <title height="145" splitType="Stretch"><element kind="textField" x="0" y="0" width="806" height="18" fontName="Arial" fontSize="10" bold="true" hTextAlign="Center"><expression><![CDATA[$P{agencyName}]]></expression></element><element kind="textField" x="0" y="18" width="806" height="13" fontName="Arial" fontSize="7" hTextAlign="Center"><expression><![CDATA[$P{agencyAddress}]]></expression></element><element kind="textField" x="0" y="34" width="806" height="22" fontName="Arial" fontSize="14" bold="true" hTextAlign="Center"><expression><![CDATA[$P{title}]]></expression></element><element kind="textField" mode="Opaque" x="0" y="58" width="806" height="15" backcolor="#DDE5F2" fontName="Arial" fontSize="7" bold="true" hTextAlign="Center"><expression><![CDATA[$P{formType} + " | " + $P{lifecycleState} + " | Rating period: " + $P{period}]]></expression></element><element kind="textField" x="0" y="76" width="400" height="15" fontName="Arial" fontSize="7"><expression><![CDATA["Ratee/Accountable Head: " + $P{employeeName} + " (" + $P{employeeNo} + ")"]]></expression></element><element kind="textField" x="406" y="76" width="400" height="15" fontName="Arial" fontSize="7"><expression><![CDATA["Position: " + $P{positionName}]]></expression></element><element kind="textField" x="0" y="92" width="806" height="15" fontName="Arial" fontSize="7"><expression><![CDATA["Office: " + $P{organizationName}]]></expression></element><element kind="textField" x="0" y="108" width="400" height="15" fontName="Arial" fontSize="7"><expression><![CDATA["Reviewed by: " + $P{supervisor}]]></expression></element><element kind="textField" x="406" y="108" width="400" height="15" fontName="Arial" fontSize="7"><expression><![CDATA["Approved by: " + $P{approver}]]></expression></element><element kind="textField" x="0" y="125" width="806" height="16" fontName="Arial" fontSize="6" textAdjust="StretchHeight"><expression><![CDATA[$P{sourceReference}]]></expression></element></title>
  <columnHeader height="34"><element kind="staticText" mode="Opaque" x="0" y="0" width="28" height="34" backcolor="#DDE5F2" fontName="Arial" fontSize="6" bold="true"><text><![CDATA[#]]></text><box><pen lineWidth="0.4"/></box></element><element kind="staticText" mode="Opaque" x="28" y="0" width="85" height="34" backcolor="#DDE5F2" fontName="Arial" fontSize="6" bold="true"><text><![CDATA[Category]]></text><box><pen lineWidth="0.4"/></box></element><element kind="staticText" mode="Opaque" x="113" y="0" width="120" height="34" backcolor="#DDE5F2" fontName="Arial" fontSize="6" bold="true"><text><![CDATA[Major Final Output / KRA]]></text><box><pen lineWidth="0.4"/></box></element><element kind="staticText" mode="Opaque" x="233" y="0" width="150" height="34" backcolor="#DDE5F2" fontName="Arial" fontSize="6" bold="true"><text><![CDATA[Success Indicator / Measure]]></text><box><pen lineWidth="0.4"/></box></element><element kind="staticText" mode="Opaque" x="383" y="0" width="90" height="34" backcolor="#DDE5F2" fontName="Arial" fontSize="6" bold="true"><text><![CDATA[Target]]></text><box><pen lineWidth="0.4"/></box></element><element kind="staticText" mode="Opaque" x="473" y="0" width="130" height="34" backcolor="#DDE5F2" fontName="Arial" fontSize="6" bold="true"><text><![CDATA[Actual Accomplishment]]></text><box><pen lineWidth="0.4"/></box></element><element kind="staticText" mode="Opaque" x="603" y="0" width="95" height="34" backcolor="#DDE5F2" fontName="Arial" fontSize="6" bold="true"><text><![CDATA[Ratings / Weight]]></text><box><pen lineWidth="0.4"/></box></element><element kind="staticText" mode="Opaque" x="698" y="0" width="108" height="34" backcolor="#DDE5F2" fontName="Arial" fontSize="6" bold="true"><text><![CDATA[Remarks]]></text><box><pen lineWidth="0.4"/></box></element></columnHeader>
  <detail><band height="50" splitType="Stretch"><element kind="textField" x="0" y="0" width="28" height="50" fontName="Arial" fontSize="6" stretchType="ContainerHeight"><expression><![CDATA[$F{rowNumber}]]></expression><box><pen lineWidth="0.3"/></box></element><element kind="textField" x="28" y="0" width="85" height="50" fontName="Arial" fontSize="6" textAdjust="StretchHeight" stretchType="ContainerHeight"><expression><![CDATA[$F{section}]]></expression><box><pen lineWidth="0.3"/></box></element><element kind="textField" x="113" y="0" width="120" height="50" fontName="Arial" fontSize="6" textAdjust="StretchHeight" stretchType="ContainerHeight"><expression><![CDATA[$F{output}]]></expression><box><pen lineWidth="0.3"/></box></element><element kind="textField" x="233" y="0" width="150" height="50" fontName="Arial" fontSize="6" textAdjust="StretchHeight" stretchType="ContainerHeight"><expression><![CDATA[$F{successIndicator}]]></expression><box><pen lineWidth="0.3"/></box></element><element kind="textField" x="383" y="0" width="90" height="50" fontName="Arial" fontSize="6" textAdjust="StretchHeight" stretchType="ContainerHeight"><expression><![CDATA[$F{target}]]></expression><box><pen lineWidth="0.3"/></box></element><element kind="textField" x="473" y="0" width="130" height="50" fontName="Arial" fontSize="6" textAdjust="StretchHeight" stretchType="ContainerHeight"><expression><![CDATA[$F{accomplishment}]]></expression><box><pen lineWidth="0.3"/></box></element><element kind="textField" x="603" y="0" width="95" height="50" fontName="Arial" fontSize="6" textAdjust="StretchHeight" stretchType="ContainerHeight"><expression><![CDATA[$F{dimensionRatings} + "\nWeight: " + $F{weight} + "%\nScore: " + ($F{score} == null ? "" : $F{score})]]></expression><box><pen lineWidth="0.3"/></box></element><element kind="textField" x="698" y="0" width="108" height="50" fontName="Arial" fontSize="6" textAdjust="StretchHeight" stretchType="ContainerHeight"><expression><![CDATA[$F{remarks}]]