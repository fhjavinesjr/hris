<!-- SQL-free, non-demographic Phase 5F.3 process analytics. -->
<jasperReport name="rsp_process_analytics" language="java" pageWidth="612" pageHeight="792" columnWidth="576" leftMargin="18" rightMargin="18" topMargin="18" bottomMargin="18" uuid="6887a625-feb6-4ccc-b3b8-5114f598a6d0">
  <property name="net.sf.jasperreports.compiler.xml.parser.validation" value="false"/>
  <parameter name="agency" class="java.lang.String"/><parameter name="from" class="java.lang.String"/><parameter name="to" class="java.lang.String"/><parameter name="dateBasis" class="java.lang.String"/><parameter name="timezone" class="java.lang.String"/><parameter name="historyMode" class="java.lang.String"/><parameter name="pageScope" class="java.lang.String"/><parameter name="filters" class="java.lang.String"/><parameter name="generated" class="java.lang.String"/><parameter name="templateVersion" class="java.lang.String"/>
  <field name="code" class="java.lang.String"/><field name="label" class="java.lang.String"/><field name="numerator" class="java.lang.Long"/><field name="denominator" class="java.lang.Long"/><field name="value" class="java.math.BigDecimal"/><field name="unit" class="java.lang.String"/><field name="definition" class="java.lang.String"/>
  <title height="112"><element kind="textField" x="0" y="0" width="576" height="18" fontName="Arial" fontSize="9" bold="true" hTextAlign="Center"><expression><![CDATA[$P{agency}]]></expression></element><element kind="staticText" x="0" y="20" width="576" height="22" fontName="Arial" fontSize="14" bold="true" hTextAlign="Center"><text><![CDATA[RSP PROCESS ANALYTICS]]></text></element><element kind="staticText" mode="Opaque" x="0" y="44" width="576" height="16" backcolor="#FDE2E2" fontSize="7" bold="true" hTextAlign="Center"><text><![CDATA[AGGREGATE PROCESS MEASURES ONLY — NO DEMOGRAPHIC OR CANDIDATE RANKING INFERENCE]]></text></element><element kind="textField" x="0" y="63" width="576" height="14" fontSize="7"><expression><![CDATA["Range: " + $P{from} + " to " + $P{to} + " | Basis: " + $P{dateBasis} + " | " + $P{timezone}]]></expression></element><element kind="textField" x="0" y="79" width="576" height="14" fontSize="6"><expression><![CDATA[$P{historyMode} + " | " + $P{pageScope}]]></expression></element><element kind="textField" x="0" y="95" width="576" height="12" fontSize="6"><expression><![CDATA["Generated: " + $P{generated}]]></expression></element></title>
  <pageHeader height="28"><element kind="textField" x="0" y="0" width="576" height="26" fontSize="6" textAdjust="StretchHeight"><expression><![CDATA[$P{filters}]]></expression></element></pageHeader>
  <columnHeader height="24"><element kind="staticText" mode="Opaque" x="0" y="0" width="205" height="24" backcolor="#DDE5F2" fontSize="6"><text><![CDATA[Metric]]></text><box><pen lineWidth="0.4"/></box></element><element kind="staticText" mode="Opaque" x="205" y="0" width="80" height="24" backcolor="#DDE5F2" fontSize="6"><text><![CDATA[Value]]></text><box><pen lineWidth="0.4"/></box></element><element kind="staticText" mode="Opaque" x="285" y="0" width="291" height="24" backcolor="#DDE5F2" fontSize="6"><text><![CDATA[Definition / numerator and denominator]]></text><box><pen lineWidth="0.4"/></box></element></columnHeader>
  <detail><band height="42" splitType="Stretch"><element kind="textField" x="0" y="0" width="205" height="42" fontSize="6" textAdjust="StretchHeight" stretchType="ContainerHeight"><expression><![CDATA[$F{label} + "\n" + $F{code}]]></expression><box><pen lineWidth="0.3"/></box></element><element kind="textField" x="205" y="0" width="80" height="42" fontSize="7" bold="true" textAdjust="StretchHeight" stretchType="ContainerHeight"><expression><![CDATA[$F{value}.toPlainString() + " " + $F{unit}]]></expression><box><pen lineWidth="0.3"/></box></element><element kind="textField" x="285" y="0" width="291" height="42" fontSize="5.5" textAdjust="StretchHeight" stretchType="ContainerHeight"><expression><![CDATA[$F{definition} + " Numerator=" + $F{numerator} + ($F{denominator} == null ? "." : "; denominator=" + $F{denominator} + ".")]]></expression><box><pen lineWidth="0.3"/></box></element></band></detail>
  <pageFooter height="16"><element kind="textField" x="0" y="2" width="576" height="12" fontSize="6" hTextAlign="Right"><expression><![CDATA["Page " + $V{PAGE_NUMBER} + " | " + $P{templateVersion}]]></expression></element></pageFooter>
</jasperReport>
