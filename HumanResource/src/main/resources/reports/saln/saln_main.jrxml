  <summary height="940" splitType="Prevent">
    <element kind="staticText" uuid="0d92d253-c4b3-4212-9e76-cc0c0fb60019" x="0" y="0" width="564" height="20" fontName="DejaVu Sans" fontSize="9" bold="true" mode="Opaque" backcolor="#D9E8F0"><text><![CDATA[2. LIABILITIES]]></text></element>
