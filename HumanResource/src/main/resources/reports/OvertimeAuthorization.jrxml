<!-- Created with Jaspersoft Studio version 7.0.6.final using JasperReports Library version 7.0.6-5d2a603fdc6b3db8f842a83383e594f41891534d  -->
<jasperReport name="OvertimeAuthorization" language="java" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="a9324661-f00c-4ff9-8ab7-a0f0dc762247">
	<property name="ireport.zoom" value="1.9487171000000014"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="HRISOF SQL Server"/>
	<parameter name="currentCompany" class="java.lang.String"/>
	<parameter name="currentCompanyAddress" class="java.lang.String"/>
	<parameter name="recommendedBy" class="java.lang.String"/>
	<parameter name="recommendedByPos" class="java.lang.String"/>
	<parameter name="approvedBy" class="java.lang.String"/>
	<parameter name="approvedByPos" class="java.lang.String"/>
	<parameter name="isJobOrder" class="java.lang.Boolean"/>
	<parameter name="requestedBy" class="java.lang.String"/>
	<parameter name="requestedByPos" class="java.lang.String"/>
	<parameter name="OVERTIME_REQUEST_ID" class="java.lang.Long"/>
	<query language="sql"><![CDATA[
WITH ranked_personnel AS (
	SELECT
		mp.employeeId,
		mp.businessUnitId,
		ROW_NUMBER() OVER (
			PARTITION BY mp.employeeId
			ORDER BY mp.id DESC
		) AS row_num
	FROM manage_personnel mp
),
ranked_settings AS (
	SELECT
		s.companyName,
		s.address,
		s.hospitalAgency,
		s.leftHeaderLogo,
		s.rightHeaderLogo,
		ROW_NUMBER() OVER (ORDER BY s.settingsId DESC) AS row_num
	FROM settings s
),
ranked_appointments AS (
	SELECT
		ea.employeeId,
		ea.jobPositionId,
		ea.natureOfAppointmentId,
		ROW_NUMBER() OVER (
			PARTITION BY ea.employeeId
			ORDER BY
				CASE
					WHEN LOWER(CAST(ea.activeAppointment AS varchar(5))) IN ('1', 'true', 't') THEN 0
					ELSE 1
				END,
				CASE WHEN ea.assumptionToDutyDate IS NULL THEN 1 ELSE 0 END,
				ea.assumptionToDutyDate DESC,
				ea.employeeAppointmentId DESC
		) AS row_num
	FROM employeeappointment ea
)
SELECT
	CONCAT(
		COALESCE(pd.firstname, COALESCE(e.firstname, '')),
		CASE WHEN COALESCE(pd.middlename, '') = '' THEN ' ' ELSE CONCAT(' ', pd.middlename, ' ') END,
		COALESCE(pd.surname, COALESCE(e.lastname, ''))
	) AS fullname,
	COALESCE(bu.businessUnitsName, '') AS businessUnit,
	CAST(ot.dateTimeFrom AS date) AS dateCovered,
	COALESCE(ot.netAuthorizedHours, COALESCE(ot.totalHours, 0)) AS noOfHours,
	COALESCE(ot.purpose, '') AS purpose,
	CASE
		WHEN LOWER(CAST(st.hospitalAgency AS varchar(5))) IN ('1', 'true', 't') THEN 1
		ELSE 0
	END AS hospitalAgency,
	COALESCE(st.companyName, '') AS currentCompanySetting,
	COALESCE(st.address, '') AS currentCompanyAddressSetting,
	st.leftHeaderLogo,
	st.rightHeaderLogo,
	CASE WHEN LOWER(COALESCE(reqNoa.nature, '')) LIKE '%job order%' THEN 1 ELSE 0 END AS isJobOrder,
	CONCAT(
		COALESCE(reqPd.firstname, COALESCE(reqEmp.firstname, '')),
		CASE WHEN COALESCE(reqPd.middlename, '') = '' THEN ' ' ELSE CONCAT(' ', reqPd.middlename, ' ') END,
		COALESCE(reqPd.surname, COALESCE(reqEmp.lastname, ''))
	) AS requestedBy,
	COALESCE(reqPos.jobPositionName, '') AS requestedByPos,
	CONCAT(
		COALESCE(recPd.firstname, COALESCE(recEmp.firstname, '')),
		CASE WHEN COALESCE(recPd.middlename, '') = '' THEN ' ' ELSE CONCAT(' ', recPd.middlename, ' ') END,
		COALESCE(recPd.surname, COALESCE(recEmp.lastname, ''))
	) AS recommendedBy,
	COALESCE(recPos.jobPositionName, '') AS recommendedByPos,
	CONCAT(
		COALESCE(appPd.firstname, COALESCE(appEmp.firstname, '')),
		CASE WHEN COALESCE(appPd.middlename, '') = '' THEN ' ' ELSE CONCAT(' ', appPd.middlename, ' ') END,
		COALESCE(appPd.surname, COALESCE(appEmp.lastname, ''))
	) AS approvedBy,
	COALESCE(appPos.jobPositionName, '') AS approvedByPos
FROM overtime_request ot
LEFT JOIN employee e ON e.employeeId = ot.employeeId
LEFT JOIN personaldata pd ON pd.employeeId = ot.employeeId
LEFT JOIN employee reqEmp ON reqEmp.employeeId = ot.employeeId
LEFT JOIN personaldata reqPd ON reqPd.employeeId = reqEmp.employeeId
LEFT JOIN employee recEmp ON recEmp.employeeId = ot.recommendedById
LEFT JOIN personaldata recPd ON recPd.employeeId = recEmp.employeeId
LEFT JOIN employee appEmp ON appEmp.employeeId = ot.approvedById
LEFT JOIN personaldata appPd ON appPd.employeeId = appEmp.employeeId
LEFT JOIN ranked_personnel mp ON mp.employeeId = ot.employeeId AND mp.row_num = 1
LEFT JOIN businessunits bu ON bu.businessUnitsId = mp.businessUnitId
LEFT JOIN ranked_settings st ON st.row_num = 1
LEFT JOIN ranked_appointments reqAppt ON reqAppt.employeeId = reqEmp.employeeId AND reqAppt.row_num = 1
LEFT JOIN job_position reqPos ON reqPos.jobPositionId = reqAppt.jobPositionId
LEFT JOIN natureofappointment reqNoa ON reqNoa.natureofappointmentId = reqAppt.natureOfAppointmentId
LEFT JOIN ranked_appointments recAppt ON recAppt.employeeId = recEmp.employeeId AND recAppt.row_num = 1
LEFT JOIN job_position recPos ON recPos.jobPositionId = recAppt.jobPositionId
LEFT JOIN ranked_appointments appAppt ON appAppt.employeeId = appEmp.employeeId AND appAppt.row_num = 1
LEFT JOIN job_position appPos ON appPos.jobPositionId = appAppt.jobPositionId
WHERE ot.overtimeRequestId = $P{OVERTIME_REQUEST_ID}
]]></query>
