<!-- Official source: 2025 ORAOHRA Annex B; provider-neutral parameter report. -->
<jasperReport name="csc_oath_of_office_2025" language="java" pageWidth="595" pageHeight="842" columnWidth="515" leftMargin="40" rightMargin="40" topMargin="25" bottomMargin="25" uuid="4be5c3da-930c-4ac2-8188-010000000001">
  <parameter name="agencyName" class="java.lang.String"/><parameter name="agencyAddress" class="java.lang.String"/>
  <parameter name="appointeeName" class="java.lang.String"/><parameter name="appointeeAddress" class="java.lang.String"/>
  <parameter name="position" class="java.lang.String"/><parameter name="governmentIdType" class="java.lang.String"/>
  <parameter name="governmentIdNumber" class="java.lang.String"/><parameter name="governmentIdDate" class="java.lang.String"/>
  <parameter name="oathDate" class="java.lang.String"/><parameter name="venue" class="java.lang.String"/>
  <parameter name="administeringName" class="java.lang.String"/><parameter name="administeringPosition" class="java.lang.String"/>
  <parameter name="templateCode" class="java.lang.String"/><parameter name="templateVersion" class="java.lang.String"/>
  <parameter name="sourceFingerprint" class="java.lang.String"/><parameter name="generated" class="java.lang.String"/>
  <title height="765" splitType="Prevent">
    <element kind="staticText" uuid="4be5c3da-930c-4ac2-8188-010000000002" x="0" y="0" width="230" height="32" fontName="DejaVu Sans" fontSize="9"><text><![CDATA[SS Form Blg. 32 / CS Form No. 32
Narebisa 2025 / Revised 2025]]></text></element>
    <element kind="staticText" uuid="4be5c3da-930c-4ac2-8188-010000000003" x="0" y="40" width="515" height="28" fontName="DejaVu Sans" fontSize="11" bold="true" hTextAlign="Center"><text><![CDATA[REPUBLIKA NG PILIPINAS / REPUBLIC OF THE PHILIPPINES]]></text></element>
    <element kind="textField" uuid="4be5c3da-930c-4ac2-8188-010000000004" x="0" y="68" width="515" height="22" fontName="DejaVu Sans" fontSize="11" bold="true" hTextAlign="Center"><expression><![CDATA[$P{agencyName}]]></expression></element>
    <element kind="staticText" uuid="4be5c3da-930c-4ac2-8188-010000000005" x="0" y="102" width="515" height="42" fontName="DejaVu Sans" fontSize="14" bold="true" hTextAlign="Center"><text><![CDATA[PANUNUMPA SA KATUNGKULAN
OATH OF OFFICE]]></text></element>
    <element kind="textField" uuid="4be5c3da-930c-4ac2-8188-010000000006" x="10" y="155" width="495" height="310" fontName="DejaVu Sans" fontSize="10" hTextAlign="Justified" markup="styled" textAdjust="StretchHeight"><expression><![CDATA["Ako si <style isUnderline=\"true\">"+$P{appointeeName}+"</style>, ng <style isUnderline=\"true\">"+$P{appointeeAddress}+"</style>, na itinalaga bilang <style isUnderline=\"true\">"+$P{position}+"</style>, ay taimtim na nanunumpa na tutuparin ko nang buong husay at katapatan, sa abot ng aking kakayahan, ang mga katungkulang pinagtalagahan sa akin at sa dapat gampanan sa iba pang pagkaraan nito’y gagampanan ko sa ilalim ng Republika ng Pilipinas; na aking itataguyod at ipagtatanggol ang Saligang Batas ng Pilipinas; na tunay na mananalig at tatalima ako rito; na susundin ko ang mga batas at mga kautusang legal, at mga dekretong pinaiiral ng mga sadyang itinakdang maykapangyarihan ng Republika ng Pilipinas; at kusa kong babalikatin ang pananagutang ito nang walang ano mang pasubali o hangaring umiwas.\n\nI, <style isUnderline=\"true\">"+$P{appointeeName}+"</style>, of <style isUnderline=\"true\">"+$P{appointeeAddress}+"</style>, having been appointed to <style isUnderline=\"true\">"+$P{position}+"</style>, hereby solemnly swear, that I will faithfully discharge to the best of my ability, the duties of my present position and of all others that I may hereafter hold under the Republic of the Philippines; to uphold and defend the Constitution; that I will bear true faith and allegiance to the same; that I will obey the laws, legal orders, and decrees promulgated by the duly constituted authorities of the Republic of the Philippines; and that I impose this obligation upon myself voluntarily, without mental reservation or purpose of evasion.\n\nKASIHAN NAWA AKO NG DIYOS. / SO HELP ME GOD."]]></expression></element>
    <element kind="textField" uuid="4be5c3da-930c-4ac2-8188-010000000007" x="285" y="485" width="220" height="20" fontName="DejaVu Sans" hTextAlign="Center"><expression><![CDATA[$P{appointeeName}]]></expression><box><bottomPen lineWidth="0.7"/></box></element>
    <element kind="staticText" uuid="4be5c3da-930c-4ac2-8188-010000000008" x="285" y="505" width="220" height="30" fontName="DejaVu Sans" fontSize="8" hTextAlign="Center"><text><![CDATA[Lagda sa itaas ng pangalan ng hinirang
Signature over Printed Name of Appointee]]></text></element>
    <element kind="textField" uuid="4be5c3da-930c-4ac2-8188-010000000009" x="10" y="545" width="300" height="54" fontName="DejaVu Sans" fontSize="9"><expression><![CDATA["Government ID: "+$P{governmentIdType}+"\nNumero ng ID: "+$P{governmentIdNumber}+"\nAraw ng Pagkakaloob: "+$P{governmentIdDate}]]></expression></element>
    <element kind="textField" uuid="4be5c3da-930c-4ac2-8188-010000000010" x="10" y="610" width="495" height="42" fontName="DejaVu Sans" fontSize="9" textAdjust="StretchHeight"><expression><![CDATA["Nilagdaan at pinanumpaan sa harap ko / Subscribed and sworn to before me this "+$P{oathDate}+" at "+$P{venue}+", Philippines."]]></expression></element>
    <element kind="textField" uuid="4be5c3da-930c-4ac2-8188-010000000011" x="285" y="665" width="220" height="20" fontName="DejaVu Sans" hTextAlign="Center"><expression><![CDATA[$P{administeringName}]]></expression><box><bottomPen lineWidth="0.7"/></box></element>
    <element kind="textField" uuid="4be5c3da-930c-4ac2-8188-010000000012" x="285" y="685" width="220" height="30" fontName="DejaVu Sans" fontSize="8" hTextAlign="Center"><expression><![CDATA[$P{administeringPosition}+"\nLagda sa itaas ng pangalan at posisyon ng opisyal na pinanumpaan"]]></expression></element>
    <element kind="textField" uuid="4be5c3da-930c-4ac2-8188-010000000013" x="0" y="730" width="515" height="26" fontName="DejaVu Sans" fontSize="6" hTextAlign="Center"><expression><![CDATA[$P{templateCode}+" "+$P{templateVersion}+" | Source "+$P{sourceFingerprint}+" | "+$P{generated}]]></expression></element>
  </title>
</jasperReport>
