    <element kind="textField" uuid="5be5c3da-930c-4ac2-8188-020000000004" x="0" y="70" width="515" height="20" fontName="DejaVu Sans" fontSize="11" bold="true" hTextAlign="Center"><expression><![CDATA[$P{agencyName}]]></expression></element>
    <element kind="staticText" uuid="5be5c3da-930c-4ac2-8188-020000000005" x="0" y="120" width="515" height="28" fontName="DejaVu Sans" fontSize="14" bold="true" hTextAlign="Center"><text><![CDATA[CERTIFICATION OF ASSUMPTION TO DUTY]]></text></element>
    <element kind="textField" uuid="5be5c3da-930c-4ac2-8188-020000000006" x="20" y="180" width="475" height="185" fontName="DejaVu Sans" fontSize="11" hTextAlign="Justified" textAdjust="StretchHeight"><expression><![CDATA["This is to certify that Ms./Mr. "+$P{appointeeName}+" has assumed the duties and responsibilities as "+$P{position}+" of "+$P{office}+" effective "+$P{assumptionDate}+".\n\nThis certification is issued in connection with the issuance of the appointment of Ms./Mr. "+$P{appointeeName}+" as "+$P{position}+".\n\nDone this "+$P{issueDate}+" in "+$P{venue}+"."]]></expression></element>
    <element kind="textField" uuid="5be5c3da-930c-4ac2-8188-020000000007" x="290" y="400" width="205" height="20" fontName="DejaVu Sans" hTextAlign="Center"><expression><![CDATA[$P{certifyingName}]]></expression><box><bottomPen lineWidth="0.7"/></box></element>
