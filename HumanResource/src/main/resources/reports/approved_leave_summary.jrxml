        <element kind="staticText" x="0" y="38" width="782" height="22" fontName="Arial" fontSize="14" bold="true" hTextAlign="Center"><text><![CDATA[APPROVED LEAVE SUMMARY]]></text></element>
        <element kind="textField" x="0" y="64" width="782" height="18" fontName="Arial" fontSize="8" hTextAlign="Center"><expression><![CDATA[$P{rangeLabel} + "  |  " + $P{area} + "  |  " + $P{businessUnit}]]></expression></element>
        <element kind="textField" x="0" y="84" width="782" height="18" fontName="Arial" fontSize="8" hTextAlign="Center"><expression><![CDATA[$P{leaveTypeLabel} + "  |  " + $P{payLabel}]]></expression></element>
    </pageHeader>
