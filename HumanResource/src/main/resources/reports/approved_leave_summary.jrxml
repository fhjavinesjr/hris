    <field name="endDate" class="java.sql.Date"/>
    <field name="approvedDays" class="java.lang.Double"/>
    <field name="payTreatment" class="java.lang.String"/>
    <variable name="filingCount" calculation="Count" class="java.lang.Integer"><expression><![CDATA[$F{employeeNo}]]></expression></variable>
    <pageHeader height="116">
        <element kind="staticText" x="0" y="0" width="782" height="14" fontName="Arial" fontSize="8" hTextAlign="Center"><text><![CDATA[Republic of the Philippines]]></text></element>
