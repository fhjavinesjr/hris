<jasperReport name="approved_leave_summary" language="java" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="782" leftMargin="30" rightMargin="30" topMargin="24" bottomMargin="24" whenNoDataType="NoDataSection" uuid="72851eae-3295-47ec-87c1-54e9c5c92fa9">
