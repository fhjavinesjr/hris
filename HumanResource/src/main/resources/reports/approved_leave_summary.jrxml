    <summary height="67"><element kind="textField" x="0" y="0" width="782" height="18" fontSize="9" bold="true"><expression><![CDATA["APPROVED FILINGS: " + $V{filingCount}]]></expression></element><element kind="staticText" x="0" y="26" width="782" height="38" fontSize="8"><text><![CDATA[Filings overlapping the selected range are shown with their full approved dates and days. Days are not prorated to the filter range. This is not a leave-balance ledger. Current Area/Business Unit assignment is used; verify historical transfers.]]></text></element></summary>
    <noData height="90"><element kind="staticText" x="0" y="10" width="782" height="25" fontSize="14" bold="true" hTextAlign="Center"><text><![CDATA[APPROVED LEAVE SUMMARY]]></text></element><element kind="staticText" x="0" y="48" width="782" height="28" fontSize="10" hTextAlign="Center"><text><![CDATA[No approved leave filings match the selected filters.]]></text></element></noData>
    <pageFooter height="18"><element kind="textField" x="700" y="0" width="82" height="15" fontSize="8" hTextAlign="Right"><expression><![CDATA["Page " + $V{PAGE_NUMBER}]]></expression></element></pageFooter>
