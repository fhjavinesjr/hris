        <element kind="textField" x="566" y="1" width="96" height="25" fontSize="8" pattern="MMM dd, yyyy"><expression><![CDATA[$F{endDate}]]></expression></element>
        <element kind="textField" x="662" y="1" width="50" height="25" fontSize="8" pattern="0.##"><expression><![CDATA[$F{approvedDays}]]></expression></element>
