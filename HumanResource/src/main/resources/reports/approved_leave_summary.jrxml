    <detail><band height="28">
        <element kind="textField" x="0" y="1" width="86" height="25" fontSize="8"><expression><![CDATA[$F{employeeNo}]]></expression></element>
        <element kind="textField" x="86" y="1" width="139" height="25" fontSize="8" textAdjust="StretchHeight"><expression><![CDATA[$F{employeeName}]]></expression></element>
        <element kind="textField" x="225" y="1" width="120" height="25" fontSize="8" textAdjust="StretchHeight"><expression><![CDATA[$F{businessUnit}]]></expression></element>
        <element kind="textField" x="345" y="1" width="125" height="25" fontSize="8" textAdjust="StretchHeight"><expression><![CDATA[$F{leaveType}]]></expression></element>
